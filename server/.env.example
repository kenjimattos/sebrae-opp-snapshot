# Conexão com o MongoDB DadosOPP (banco em <host-do-banco>).
# Copie para .env e preencha usuário/senha. .env NÃO é versionado.
MONGO_URI=mongodb://USUARIO:SENHA@<host-do-banco>:27017/?authSource=DadosOPP
MONGO_DB=DadosOPP

# Porta do processo da API na máquina da app (<host-da-app>). O Nginx faz proxy
# de /api/* para cá.
PORT=3000
HOST=0.0.0.0
